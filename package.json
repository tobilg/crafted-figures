{
  "name": "crafted-figures-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node skill/crafted-figures/scripts/figures.mjs build",
    "preview": "node skill/crafted-figures/scripts/figures.mjs preview",
    "check": "node skill/crafted-figures/scripts/figures.mjs check",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "test:package": "node tests/package.mjs",
    "prototype:build": "node experiments/three-hybrid/build.mjs",
    "test:prototype": "node tests/prototype.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "test:migration": "node tests/migration-browser.mjs",
    "templates:sync": "node scripts/sync-templates.mjs",
    "audit": "node skill/crafted-figures/scripts/figures.mjs audit",
    "test:geometry": "node --test tests/migration.test.mjs tests/geometry.test.mjs",
    "drive": "node skill/crafted-figures/scripts/figures.mjs drive",
    "print": "node skill/crafted-figures/scripts/figures.mjs print",
    "test:effects": "node tests/effect-registration.mjs && node tests/volume-depth.mjs && node tests/effects.mjs && node tests/optics.mjs",
    "test:motion": "node --test tests/motion.test.mjs",
    "test:react": "next build tests/fixtures/next --webpack && node tests/react.mjs",
    "bundle": "node skill/crafted-figures/scripts/figures.mjs bundle",
    "types:build": "tsc -p tsconfig.declarations.json",
    "test:types": "tsc -p tsconfig.consumer.json && tsc -p tsconfig.check.json",
    "test:print": "node tests/print.mjs && node tests/render-pdfs.mjs",
    "test:compat": "node tests/compat.mjs",
    "test:parity": "node tests/parity.mjs",
    "bench:capacity": "node tests/capacity.mjs && node tests/next-capacity-build.mjs && node tests/react.mjs --capacity",
    "test:diagnostics": "node tests/drive-suite.mjs && node tests/diagnostics-browser.mjs",
    "test:materials": "node tests/materials.mjs",
    "test:audit": "node tests/audit-faults.mjs && node tests/audit-envelopes.mjs",
    "test:react:dev": "node tests/react.mjs --dev",
    "test:fidelity": "node tests/fidelity-browser.mjs",
    "test:construction": "node tests/construction.mjs",
    "test:gaps": "node --test tests/gap-contract.test.mjs && node tests/gap-browser.mjs && node tests/static-print.mjs",
    "test:release": "node tests/release.mjs",
    "runtime:build": "npm --prefix skill/crafted-figures run runtime:build",
    "test:bundled": "node tests/bundled-runtime.mjs",
    "test:owned": "node tests/owned-renderer-browser.mjs",
    "prepare:dev": "node scripts/prepare-skill.mjs",
    "test:distribution": "node tests/distribution.mjs",
    "test:source-package": "node tests/source-package.mjs",
    "evidence:pack": "node scripts/evaluation-evidence.mjs",
    "test:print:references": "node tests/print-references.mjs",
    "test:interaction": "node tests/interaction-browser.mjs",
    "test:wasm": "node tests/wasm-independence.mjs",
    "test:zbuffer": "node tests/zbuffer-browser.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "fflate": "0.8.3",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
