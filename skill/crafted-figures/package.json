{
  "name": "crafted-figures",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "crafted-figures": "scripts/figures.mjs"
  },
  "types": "./types/index.d.mts",
